<launch>
  <arg name="map_file" default="$(env HOME)/maps/lab.yaml"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="map_frame" default="map"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="initial_x" default="0.0"/>
  <arg name="initial_y" default="0.0"/>
  <arg name="initial_yaw" default="0.0"/>
  <arg name="set_initial_pose" default="false"/>
  <arg name="rviz" default="false"/>

  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)"/>

  <node name="amcl" pkg="amcl" type="amcl" output="screen" respawn="true" respawn_delay="2.0">
    <remap from="scan" to="$(arg scan_topic)"/>
    <param name="global_frame_id" value="$(arg map_frame)"/>
    <param name="odom_frame_id" value="$(arg odom_frame)"/>
    <param name="base_frame_id" value="$(arg base_frame)"/>
    <param name="use_map_topic" value="true"/>
    <param name="transform_tolerance" value="0.5"/>
    <param name="initial_pose_x" value="$(arg initial_x)"/>
    <param name="initial_pose_y" value="$(arg initial_y)"/>
    <param name="initial_pose_a" value="$(arg initial_yaw)"/>
  </node>

  <node if="$(arg set_initial_pose)" pkg="warehouse_tuning" type="initial_pose_setter.py"
        name="initial_pose_setter" output="screen">
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="x" value="$(arg initial_x)"/>
    <param name="y" value="$(arg initial_y)"/>
    <param name="yaw" value="$(arg initial_yaw)"/>
  </node>

  <node if="$(arg rviz)" name="field_calibration_rviz" pkg="rviz" type="rviz"/>
</launch>
