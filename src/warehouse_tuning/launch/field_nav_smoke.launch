<launch>
  <arg name="start_localization" default="true"/>
  <arg name="map_file" default="$(env HOME)/maps/lab.yaml"/>
  <arg name="zone_file" default="$(env HOME)/maps/abc_zones.yaml"/>
  <arg name="sequence" default="A,B,C,A"/>
  <arg name="initial_pose_zone" default="A"/>
  <arg name="rviz" default="true"/>
  <arg name="rvizconfig" default="$(find warehouse_tuning)/rviz/field_nav_smoke.rviz"/>
  <arg name="localization_mode" default="manual"/>
  <arg name="set_initial_pose" default="false"/>
  <arg name="localization_timeout" default="120.0"/>
  <arg name="manual_assist_after" default="15.0"/>
  <arg name="confirm_before_cruise" default="true"/>
  <arg name="amcl_xy_cov_threshold" default="0.25"/>
  <arg name="amcl_yaw_cov_threshold" default="0.25"/>
  <arg name="dry_run" default="false"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="map_frame" default="map"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="drive_mode" default="forward"/>
  <arg name="max_linear" default="0.25"/>
  <arg name="max_angular" default="0.60"/>
  <arg name="min_linear" default="0.08"/>
  <arg name="min_angular" default="0.12"/>
  <arg name="dist_tolerance" default="0.12"/>
  <arg name="yaw_tolerance" default="0.20"/>
  <arg name="path_yaw_tolerance" default="0.22"/>
  <arg name="final_yaw_distance" default="0.30"/>
  <arg name="goal_timeout" default="120.0"/>
  <arg name="path_min_distance" default="0.03"/>
  <arg name="allow_placeholder_pose" default="false"/>

  <include if="$(arg start_localization)" file="$(find warehouse_tuning)/launch/field_localization.launch">
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="scan_topic" value="$(arg scan_topic)"/>
    <arg name="map_frame" value="$(arg map_frame)"/>
    <arg name="odom_frame" value="$(arg odom_frame)"/>
    <arg name="base_frame" value="$(arg base_frame)"/>
    <arg name="rviz" value="false"/>
  </include>

  <node if="$(arg rviz)" name="field_nav_smoke_rviz" pkg="rviz" type="rviz"
        args="-d $(arg rvizconfig)"/>

  <node pkg="warehouse_tuning" type="field_nav_smoke.py" name="field_nav_smoke" output="screen" required="true">
    <param name="zone_file" value="$(arg zone_file)"/>
    <param name="sequence" value="$(arg sequence)"/>
    <param name="initial_pose_zone" value="$(arg initial_pose_zone)"/>
    <param name="localization_mode" value="$(arg localization_mode)"/>
    <param name="set_initial_pose" value="$(arg set_initial_pose)"/>
    <param name="localization_timeout" value="$(arg localization_timeout)"/>
    <param name="manual_assist_after" value="$(arg manual_assist_after)"/>
    <param name="confirm_before_cruise" value="$(arg confirm_before_cruise)"/>
    <param name="amcl_xy_cov_threshold" value="$(arg amcl_xy_cov_threshold)"/>
    <param name="amcl_yaw_cov_threshold" value="$(arg amcl_yaw_cov_threshold)"/>
    <param name="dry_run" value="$(arg dry_run)"/>
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="drive_mode" value="$(arg drive_mode)"/>
    <param name="max_linear" value="$(arg max_linear)"/>
    <param name="max_angular" value="$(arg max_angular)"/>
    <param name="min_linear" value="$(arg min_linear)"/>
    <param name="min_angular" value="$(arg min_angular)"/>
    <param name="dist_tolerance" value="$(arg dist_tolerance)"/>
    <param name="yaw_tolerance" value="$(arg yaw_tolerance)"/>
    <param name="path_yaw_tolerance" value="$(arg path_yaw_tolerance)"/>
    <param name="final_yaw_distance" value="$(arg final_yaw_distance)"/>
    <param name="goal_timeout" value="$(arg goal_timeout)"/>
    <param name="path_min_distance" value="$(arg path_min_distance)"/>
    <param name="allow_placeholder_pose" value="$(arg allow_placeholder_pose)"/>
  </node>
</launch>
