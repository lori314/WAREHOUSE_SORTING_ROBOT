<?xml version="1.0"?>
<robot name="small_blue_box">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
  </link>

  <link name="body_link">
    <visual>
      <geometry>
        <box size="0.055 0.055 0.055"/>
      </geometry>
      <origin xyz="0 0 0.0275" rpy="0 0 0"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0275" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.055 0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00008"/>
    </inertial>
  </link>

  <joint name="base_to_body" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="body_link">
    <material>Gazebo/Blue</material>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <mu1>50.0</mu1>
    <mu2>50.0</mu2>
    <maxVel>0.5</maxVel>
    <minDepth>0.001</minDepth>
  </gazebo>
</robot>
