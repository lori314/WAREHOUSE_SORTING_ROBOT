<launch>
  <arg name="start_runtime" default="true"/>
  <arg name="point_cloud_topic" default="/kinect2/qhd/points"/>
  <arg name="start_point_cloud" default="true"/>

  <arg name="trials" default="1"/>
  <arg name="target_color" default="green"/>
  <arg name="manual_step" default="true"/>
  <arg name="dry_run" default="false"/>
  <arg name="object_wait_timeout" default="8.0"/>
  <arg name="result_timeout" default="80.0"/>

  <arg name="selection_target_x" default="1.05"/>
  <arg name="selection_target_y" default="0.0"/>
  <arg name="action_x_offset" default="0.0"/>
  <arg name="action_y_offset" default="0.0"/>
  <arg name="action_z_offset" default="0.0"/>
  <arg name="action_x_override" default=""/>
  <arg name="action_y_override" default=""/>
  <!-- Current real table is measured at 0.75m; leave empty to trust detected object z. -->
  <arg name="action_z_override" default="0.75"/>

  <arg name="cube_min_x" default="0.04"/>
  <arg name="cube_max_x" default="0.18"/>
  <arg name="cube_min_y" default="0.04"/>
  <arg name="cube_max_y" default="0.18"/>
  <arg name="cube_min_z" default="0.035"/>
  <arg name="cube_max_z" default="0.18"/>
  <arg name="table_height_min" default="0.70"/>
  <arg name="table_height_max" default="0.80"/>
  <arg name="grasp_x_ratio" default="0.50"/>
  <arg name="grasp_y_ratio" default="0.50"/>
  <arg name="grasp_z_ratio" default="0.00"/>

  <arg name="grab_y_offset" default="0.00"/>
  <arg name="grab_y_side_offset_enabled" default="true"/>
  <arg name="grab_y_left_offset" default="-0.05"/>
  <arg name="grab_y_center_offset" default="0.00"/>
  <arg name="grab_y_right_offset" default="-0.025"/>
  <arg name="grab_y_side_deadband" default="0.015"/>
  <arg name="grab_y_axis_left_positive" default="true"/>
  <arg name="grab_y_color_offset_enabled" default="true"/>
  <arg name="grab_y_default_color" default="green"/>
  <arg name="grab_y_green_offset_delta" default="0.00"/>
  <arg name="grab_y_red_offset_delta" default="0.04"/>
  <arg name="target_color_topic" default="/wpb_home/grab_target_color"/>
  <arg name="grab_lift_offset" default="0.05"/>
  <arg name="grab_forward_offset" default="0.0"/>
  <arg name="grab_gripper_value" default="0.012"/>
  <arg name="grab_target_x" default="1.05"/>
  <arg name="grab_target_y" default="0.0"/>
  <arg name="grab_close_target_x" default="0.65"/>
  <arg name="grab_close_target_y" default="0.0"/>
  <arg name="fine_align_enabled" default="true"/>
  <arg name="fine_align_timeout" default="6.0"/>
  <arg name="fine_align_fresh_timeout" default="1.5"/>
  <arg name="fine_align_x_tolerance" default="0.025"/>
  <arg name="fine_align_y_tolerance" default="0.015"/>
  <arg name="fine_align_kp_x" default="0.45"/>
  <arg name="fine_align_kp_y" default="0.80"/>
  <arg name="fine_align_max_vel" default="0.08"/>
  <arg name="wait_for_lift_before_forward" default="true"/>
  <arg name="lift_ready_tolerance" default="0.02"/>
  <arg name="lift_wait_timeout" default="35.0"/>
  <arg name="lift_min_wait_seconds" default="0.5"/>
  <arg name="lift_command_to_joint_offset" default="0.35"/>
  <arg name="joint_states_topic" default="/joint_states"/>

  <include if="$(arg start_runtime)" file="$(find warehouse_tuning)/launch/wpb_grab_action_runtime.launch">
    <arg name="point_cloud_topic" value="$(arg point_cloud_topic)"/>
    <arg name="start_point_cloud" value="$(arg start_point_cloud)"/>
    <arg name="cube_min_x" value="$(arg cube_min_x)"/>
    <arg name="cube_max_x" value="$(arg cube_max_x)"/>
    <arg name="cube_min_y" value="$(arg cube_min_y)"/>
    <arg name="cube_max_y" value="$(arg cube_max_y)"/>
    <arg name="cube_min_z" value="$(arg cube_min_z)"/>
    <arg name="cube_max_z" value="$(arg cube_max_z)"/>
    <arg name="table_height_min" value="$(arg table_height_min)"/>
    <arg name="table_height_max" value="$(arg table_height_max)"/>
    <arg name="grasp_x_ratio" value="$(arg grasp_x_ratio)"/>
    <arg name="grasp_y_ratio" value="$(arg grasp_y_ratio)"/>
    <arg name="grasp_z_ratio" value="$(arg grasp_z_ratio)"/>
    <arg name="grab_y_offset" value="$(arg grab_y_offset)"/>
    <arg name="grab_y_side_offset_enabled" value="$(arg grab_y_side_offset_enabled)"/>
    <arg name="grab_y_left_offset" value="$(arg grab_y_left_offset)"/>
    <arg name="grab_y_center_offset" value="$(arg grab_y_center_offset)"/>
    <arg name="grab_y_right_offset" value="$(arg grab_y_right_offset)"/>
    <arg name="grab_y_side_deadband" value="$(arg grab_y_side_deadband)"/>
    <arg name="grab_y_axis_left_positive" value="$(arg grab_y_axis_left_positive)"/>
    <arg name="grab_y_color_offset_enabled" value="$(arg grab_y_color_offset_enabled)"/>
    <arg name="grab_y_default_color" value="$(arg grab_y_default_color)"/>
    <arg name="grab_y_green_offset_delta" value="$(arg grab_y_green_offset_delta)"/>
    <arg name="grab_y_red_offset_delta" value="$(arg grab_y_red_offset_delta)"/>
    <arg name="target_color_topic" value="$(arg target_color_topic)"/>
    <arg name="grab_lift_offset" value="$(arg grab_lift_offset)"/>
    <arg name="grab_forward_offset" value="$(arg grab_forward_offset)"/>
    <arg name="grab_gripper_value" value="$(arg grab_gripper_value)"/>
    <arg name="grab_target_x" value="$(arg grab_target_x)"/>
    <arg name="grab_target_y" value="$(arg grab_target_y)"/>
    <arg name="grab_close_target_x" value="$(arg grab_close_target_x)"/>
    <arg name="grab_close_target_y" value="$(arg grab_close_target_y)"/>
    <arg name="fine_align_enabled" value="$(arg fine_align_enabled)"/>
    <arg name="fine_align_timeout" value="$(arg fine_align_timeout)"/>
    <arg name="fine_align_fresh_timeout" value="$(arg fine_align_fresh_timeout)"/>
    <arg name="fine_align_x_tolerance" value="$(arg fine_align_x_tolerance)"/>
    <arg name="fine_align_y_tolerance" value="$(arg fine_align_y_tolerance)"/>
    <arg name="fine_align_kp_x" value="$(arg fine_align_kp_x)"/>
    <arg name="fine_align_kp_y" value="$(arg fine_align_kp_y)"/>
    <arg name="fine_align_max_vel" value="$(arg fine_align_max_vel)"/>
    <arg name="wait_for_lift_before_forward" value="$(arg wait_for_lift_before_forward)"/>
    <arg name="lift_ready_tolerance" value="$(arg lift_ready_tolerance)"/>
    <arg name="lift_wait_timeout" value="$(arg lift_wait_timeout)"/>
    <arg name="lift_min_wait_seconds" value="$(arg lift_min_wait_seconds)"/>
    <arg name="lift_command_to_joint_offset" value="$(arg lift_command_to_joint_offset)"/>
    <arg name="joint_states_topic" value="$(arg joint_states_topic)"/>
  </include>

  <rosparam file="$(find arm_grab_task)/config/wpb_pick_unit_test_params.yaml" command="load"/>

  <node pkg="arm_grab_task"
        type="wpb_pick_unit_test.py"
        name="wpb_pick_unit_test"
        output="screen"
        required="true">
    <param name="trials" type="int" value="$(arg trials)"/>
    <param name="target_color" type="string" value="$(arg target_color)"/>
    <param name="target_color_topic" type="string" value="$(arg target_color_topic)"/>
    <param name="manual_step" type="bool" value="$(arg manual_step)"/>
    <param name="dry_run" type="bool" value="$(arg dry_run)"/>
    <param name="object_wait_timeout" type="double" value="$(arg object_wait_timeout)"/>
    <param name="result_timeout" type="double" value="$(arg result_timeout)"/>
    <param name="selection_target_x" type="double" value="$(arg selection_target_x)"/>
    <param name="selection_target_y" type="double" value="$(arg selection_target_y)"/>
    <param name="action_x_offset" type="double" value="$(arg action_x_offset)"/>
    <param name="action_y_offset" type="double" value="$(arg action_y_offset)"/>
    <param name="action_z_offset" type="double" value="$(arg action_z_offset)"/>
    <param name="action_x_override" type="string" value="$(arg action_x_override)"/>
    <param name="action_y_override" type="string" value="$(arg action_y_override)"/>
    <param name="action_z_override" type="string" value="$(arg action_z_override)"/>
  </node>
</launch>
